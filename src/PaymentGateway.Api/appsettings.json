{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SupportedCurrencies": [ "GBP", "USD", "EUR" ],
  "BankSimulator": {
    "BaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 5
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "payment_gateway"
  },
  "CredentialCache": {
    "TtlHours": 4
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789abcdef",
    "ExpiryMinutes": 15
  }
}
