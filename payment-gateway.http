### Payment Gateway — manual API walkthrough
#
# Run with VS Code's "REST Client" extension or JetBrains' built-in HTTP Client. Variables
# below (defined with @name) are referenced as {{name}}. Send the token request FIRST (line 28),
# then any other request — `{{token.response.body.accessToken}}` resolves from the captured response.
#
# Prerequisite (Docker required):
#   docker compose up --build     # brings up bank_simulator + mongo + api on localhost:5067
#   # OR (for unit tests against real services):
#   docker compose up -d bank_simulator mongo
#
# Bank simulator rule (imposters/bank_simulator.ejs): last digit of card_number decides the
# outcome — odd (1/3/5/7/9) → Authorized, even (2/4/6/8) → Declined, 0 → 503.

@host = http://localhost:5067
@demoClientId = demo-merchant
@demoClientSecret = demo-secret

###############################################################################
# 1. Auth: mint a bearer token from /api/auth/token
#    Exercises the full Mongo → CredentialCache → BCrypt → JWT issuance chain.
###############################################################################

# @name token
# Send this first; subsequent requests reference it as {{token.response.body.accessToken}}.
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "{{demoClientId}}",
  "clientSecret": "{{demoClientSecret}}"
}

###
# Wrong secret → 401 (uniform — no existence leak between unknown client and wrong secret).
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "{{demoClientId}}",
  "clientSecret": "wrong-secret"
}

###
# Blank credentials → 400.
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "",
  "clientSecret": ""
}

###############################################################################
# 2. POST /api/payments — happy path (Authorized / Declined) and failure paths (503 / 400)
###############################################################################

# @name authorizedPayment
# Card ends in 1 → Authorized. 201 with a Location header pointing at the GET route.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name declinedPayment
# Card ends in 2 → Declined. The bank adjudicated; the gateway still persists and returns 201.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248872",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name bankUnavailablePayment
# Card ends in 0 → 503 (bank-unavailable). Nothing persisted; merchant may retry with a
# different Idempotency-Key once the bank is back.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248870",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name validationRejected
# Card number too short, expiry in the past → 400. Bank is not called.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "123",
  "expiryMonth": 1,
  "expiryYear": 2020,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###############################################################################
# 3. GET /api/payments/{id} — retrieve a payment
#    Uses the id captured from the Authorized POST above.
###############################################################################

# @name getAuthorizedPayment
GET {{host}}/api/payments/{{authorizedPayment.response.body.id}}
Authorization: Bearer {{token.response.body.accessToken}}

###
# GET on a non-existent id → 404.
GET {{host}}/api/payments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token.response.body.accessToken}}

###############################################################################
# 4. Idempotency-Key (ADR-0003) — opt-in safe retries
#    The merchant picks one UUID per logical purchase attempt; replays with the same key + same
#    body return the cached response without re-calling the bank (the safety property).
###############################################################################

# @name idempotentFirst
# First POST with this Idempotency-Key → 201, response cached.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name idempotentReplay
# Same key + same body → replayed from the cache. The bank is NOT called again. The id
# matches the response from `idempotentFirst`.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name idempotentHashMismatch
# Same key + different body (amount changed) → 422. The key was bound to a specific payload;
# reusing it with a different payload is a misuse the gateway rejects explicitly.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 999,
  "cvv": "123"
}

###############################################################################
# 5. Auth-gating — every payments request without a valid bearer token → 401
###############################################################################

# @name noToken
POST {{host}}/api/payments
Content-Type: application/json

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name malformedBearer
GET {{host}}/api/payments/{{authorizedPayment.response.body.id}}
Authorization: Bearer not-a-real-jwt