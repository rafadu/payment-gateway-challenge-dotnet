### Payment Gateway — manual API walkthrough
#
# Run with VS Code's "REST Client" extension or JetBrains' built-in HTTP Client. Variables
# below (defined with @name) are referenced as {{name}}. The two response-capture directives
# `> {% %}` (REST Client) and `//> {% %}` (JetBrains) use the response from one request to feed
# the next.
#
# Prerequisites:
#   1. docker-compose up -d bank_simulator mongo        (Mongo seed runs once on first start)
#   2. mongosh payment_gateway --quiet --eval 'db.merchants.find().toArray()'
#      → expect one merchant: clientId="demo-merchant"
#   3. dotnet run --project src/PaymentGateway.Api
#      → API listens on http://localhost:5067 (HTTP) and https://localhost:7092 (HTTPS);
#        change the @host variable below if your launch profile binds elsewhere.
#
# Bank simulator rule (imposters/bank_simulator.ejs): last digit of card_number decides the
# outcome — odd (1/3/5/7/9) → Authorized, even (2/4/6/8) → Declined, 0 → 503 bank-unavailable.

@host = http://localhost:5067
@demoClientId = demo-merchant
@demoClientSecret = demo-secret

###############################################################################
# 1. Auth: mint a bearer token from /api/auth/token
#    Exercises the full Mongo → CredentialCache → BCrypt → JWT issuance chain.
###############################################################################

### @name token
# @name token tells the REST Client to capture the response into a `token` variable.
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "{{demoClientId}}",
  "clientSecret": "{{demoClientSecret}}"
}

###
# @name badSecretToken
# Uniform 401 for wrong-secret / unknown-client (ADR-0010) — no existence leak.
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "{{demoClientId}}",
  "clientSecret": "wrong-secret"
}

###
# @name blankCredsToken
# Blank credentials → 400 (rejected before the cache lookup).
POST {{host}}/api/auth/token
Content-Type: application/json

{
  "clientId": "",
  "clientSecret": ""
}

###############################################################################
# 2. POST /api/payments — happy path: Authorized
###############################################################################

### @name authorizedPayment
# Card ends in 1 → Authorized. The response carries a Location header pointing at the GET route.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name declinedPayment
# Card ends in 2 → Declined. The bank adjudicated; the gateway still persists and returns 201.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248872",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name bankUnavailablePayment
# Card ends in 0 → 503 (bank-unavailable). Nothing persisted; merchant may retry with the
# same Idempotency-Key once the bank is back.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "2222405343248870",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name validationRejected
# Card number too short, expiry in the past → 400. Bank is not called.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json

{
  "cardNumber": "123",
  "expiryMonth": 1,
  "expiryYear": 2020,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###############################################################################
# 3. GET /api/payments/{id} — retrieve a payment
#    Use the id captured from the authorizedPayment response.
###############################################################################

### @name getAuthorizedPayment
GET {{host}}/api/payments/{{authorizedPayment.response.body.id}}
Authorization: Bearer {{token.response.body.accessToken}}

###
# GET cross-merchant → 404. Cross-merchant access returns 404 (not 403), so existence of
# another merchant's payment is never revealed (ADR-0010). This seed only has one merchant,
# so this is just an arbitrary id to exercise the "not found" half of the branch.
GET {{host}}/api/payments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token.response.body.accessToken}}

###############################################################################
# 4. Idempotency-Key (ADR-0003) — opt-in safe retries
#    The merchant picks one UUID per logical purchase attempt; replays with the same key + same
#    body return the cached response without re-calling the bank.
###############################################################################

### @name idempotentFirst
# First POST with this Idempotency-Key → 201, response cached. Card ends in 1 → Authorized.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name idempotentReplay
# Same key + same body → replayed from the cache. The bank is NOT called again. The id matches
# the response from `idempotentFirst`.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name idempotentHashMismatch
# Same key + different body (amount changed) → 422. The key was bound to a specific payload;
# reusing it with a different payload is a misuse the gateway rejects explicitly.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 999,
  "cvv": "123"
}

###
# @name idempotentBankFailureReleases
# Card ends in 0 → bank 503. The filter releases the claim on a 5xx so the merchant's retry
# can land cleanly once the bank recovers — NOT cached as a 503.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 22222222-2222-2222-2222-222222222222

{
  "cardNumber": "2222405343248870",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name idempotentRetryAfterBankRecovers
# Same key + same body after the 503 above → 201 (not 503 replay). The bank is now up and the
# claim was released. New payment, new id.
POST {{host}}/api/payments
Authorization: Bearer {{token.response.body.accessToken}}
Content-Type: application/json
Idempotency-Key: 22222222-2222-2222-2222-222222222222

{
  "cardNumber": "2222405343248870",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###############################################################################
# 5. Auth-gating — every payments request without a valid bearer token → 401
###############################################################################

### @name noToken
POST {{host}}/api/payments
Content-Type: application/json

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}

###
# @name malformedBearer
GET {{host}}/api/payments/{{authorizedPayment.response.body.id}}
Authorization: Bearer not-a-real-jwt

###
# @name wrongSigningKey
# Token signed with a different HMAC key than the one in appsettings.json. The server can't
# validate the signature → 401.
POST {{host}}/api/payments
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJtZXJjaGFudC1BIn0.different-signing-key-different-signing-key-different
Content-Type: application/json

{
  "cardNumber": "2222405343248871",
  "expiryMonth": 12,
  "expiryYear": 2030,
  "currency": "GBP",
  "amount": 100,
  "cvv": "123"
}